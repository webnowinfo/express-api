// Prisma schema for the science_db database (introspected with `prisma db pull`).
// Generates a separate client into node_modules/.prisma-science (a dot-folder, like Prisma's own
// .prisma/client, so yarn does not prune it), imported from '.prisma-science/client'.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma-science/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_SCIENCE")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model basic_data_route {
  id        Int                         @id @default(autoincrement())
  name      String                      @db.VarChar(255)
  langID    Int
  status    Int                         @default(1)
  person    Int?
  isPrivate basic_data_route_isPrivate?
  isSite    basic_data_route_isSite?
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model basic_item {
  id       Int                  @id @default(autoincrement())
  item     String?              @db.VarChar(150)
  unit     Bytes?               @db.VarBinary(100)
  writable Int                  @db.TinyInt
  isDelete basic_item_isDelete?
}

model basic_modules {
  id          Int                      @id @default(autoincrement())
  module_name String?                  @db.VarChar(200)
  module_path String?                  @db.VarChar(255)
  treeCode    String?                  @db.VarChar(200)
  parent_id   Int?
  show_flag   basic_modules_show_flag? @default(yes)
  icon        String?                  @db.VarChar(100)
}

model basic_partdivision {
  id               Int    @id @default(autoincrement())
  main_data_part   String @db.Text
  extra_data_part  String @db.Text
  main_forum_part  String @db.Text
  extra_forum_part String @db.Text
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model basic_spread_method {
  id     BigInt @id @default(autoincrement())
  method String @db.VarChar(256)
}

model basic_view_range {
  id         Int                         @id @default(autoincrement())
  perm_type  basic_view_range_perm_type?
  module_ids String?                     @db.Text
}

model bureau_decoration {
  id         Int     @id @default(autoincrement())
  depart_id  Int?
  level      Int?
  empCnt     Int?
  indCnt     Int?
  otherCnt   Int?
  square     Int?
  netStatus  Int?
  compCnt    Int?
  projCnt    Int?
  IdcCnt     Int?
  extraCnt   Int?
  bookCnt    Int?
  deskCnt    Int?
  chairCnt   Int?
  smallCnt   Int?
  power      String? @db.Text
  heat       String? @db.Text
  comment    String? @db.Text
  created_at String? @db.VarChar(200)
}

model bureau_members {
  id              Int                       @id @default(autoincrement())
  user_id         Int?
  perm_type       bureau_members_perm_type?
  view_depart_ids String?                   @db.Text
  gender          bureau_members_gender?
  party           bureau_members_party?
  tec_type        bureau_members_tec_type?
  tec_level       Int?
  school          String?                   @db.VarChar(250)
  capacity        bureau_members_capacity?
  comment         String?                   @db.Text
  flag            bureau_members_flag
  in_date         DateTime?                 @db.Date
  out_date        DateTime?                 @db.Date
  equ_ip          String?                   @db.VarChar(255)
  equ_mac         String?                   @db.VarChar(255)
}

model notebook_lesson {
  id         Int     @id @default(autoincrement())
  created_at String? @db.VarChar(200)
  depart_ids String? @db.Text
  text_cnt   Int?
  lesson_cnt Int?
}

model notebook_scidata {
  id          Int     @id @default(autoincrement())
  korean_cnt  Int?
  foreign_cnt Int?
  program_cnt Int?
  year_item   Int?
  month_item  Int?
  depart_ids  String? @db.Text
  locker      Int?    @default(-1)
  media_cnt   Int?
  other_cnt   Int?
  article_cnt Int?
  success_cnt Int?
  tech_cnt    Int?
  system_name String? @db.VarChar(255)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model reed_student {
  id              Int                  @id @default(autoincrement())
  user_id         Int?
  gender          reed_student_gender?
  party           reed_student_party?
  branch          String?              @db.VarChar(200)
  enter_date      DateTime?            @db.Date
  leave_date      DateTime?            @db.Date
  status          reed_student_status? @default(running)
  note            String?              @db.Text
  total_terms     Int?                 @default(8)
  grade           Int?                 @default(1)
  total_subjects  Int?                 @default(0)
  passed_subjects Int                  @default(0)
  univ_id         Int?
}

model reed_university {
  id        Int     @id @default(autoincrement())
  univ_name String? @db.VarChar(200)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model room_comlist {
  id          Int       @id @default(autoincrement())
  name        String?   @db.VarChar(200)
  device_type String?   @db.VarChar(200)
  device_num  Int?
  reg_date    DateTime? @default(dbgenerated("'2000-01-01'")) @db.Date
  manager     String?   @db.VarChar(200)
  reg_depart  String?   @db.VarChar(200)
  comment     String?   @db.Text
  usable      Boolean?  @default(false)
}

model room_operator {
  id      Int  @id @default(autoincrement())
  user_id Int?
}

model room_person {
  id        Int                    @id @default(autoincrement())
  room_type room_person_room_type?
  person    Int?
  is_charge room_person_is_charge?
}

model room_plan {
  id         Int     @id @default(autoincrement())
  year       String? @db.VarChar(200)
  week_index Int?
  content    String? @db.Text
  units      String? @db.Text
  execution  String? @db.Text
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model room_review {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  conference  String   @db.VarChar(255)
  participant Int
  place       String   @db.VarChar(255)
  report      String   @db.VarChar(255)
  organize    String   @db.VarChar(255)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model room_rundoc {
  id              BigInt   @id @default(autoincrement())
  depart_id       BigInt
  sub_depart_name String?  @db.VarChar(256)
  created_at      DateTime @db.Date
  method_id       BigInt
  run_content     String   @db.Text
  run_period      BigInt
  comment         String   @db.Text
}

model room_runplan {
  id         Int       @id @default(autoincrement())
  year_item  Int?
  month_item Int?
  depart_id  Int?
  content    String?   @db.Text
  net_type   String?   @db.Text
  plan_date  DateTime? @db.Date
  user_state String?   @db.Text
  plan_state String?   @db.Text
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model room_runstate {
  id        Int       @id @default(autoincrement())
  user_id   Int?
  date      DateTime? @db.Date
  route_id  Int?
  use_type  Int?
  cnt       Int?
  demand    String?   @db.VarChar(255)
  pay_type  Int?      @default(0)
  cost      Float?    @db.Float
  view_time Float?    @db.Float
}

model session_info {
  id         String @id @db.VarChar(128)
  ip_address String @db.VarChar(45)
  timestamp  Int    @default(0) @db.UnsignedInt
  data       Bytes  @db.Blob

  @@index([timestamp], map: "sessions_timestamp")
}

