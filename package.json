{
  "name": "forum-science",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the forum and science databases (kcc_main, science_db): role-based auth and CRUD for every table. Node 20, Express 5, Prisma 6, MySQL.",
  "main": "src/index.ts",
  "author": "Ryan",
  "license": "MIT",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "start": "yarn build && pm2 start ecosystem.config.json --no-daemon",
    "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
    "build": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "jest -i --colors --verbose",
    "test:watch": "jest -i --watchAll",
    "test:coverage": "jest -i --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.ts",
    "prettier:fix": "prettier --write **/*.ts",
    "create-admin": "cross-env NODE_ENV=development ts-node scripts/create-admin.ts",
    "db:pull": "prisma db pull && prisma db pull --schema prisma/science/schema.prisma && yarn db:generate",
    "db:generate": "prisma generate && prisma generate --schema prisma/science/schema.prisma",
    "db:studio": "prisma studio",
    "db:studio:science": "prisma studio --schema prisma/science/schema.prisma --port 5556",
    "postinstall": "prisma generate --schema prisma/science/schema.prisma"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "prisma",
    "mysql",
    "rest",
    "api",
    "jwt",
    "rbac",
    "swagger"
  ],
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.0.2",
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.3",
    "@types/node": "^20.19.43",
    "@types/passport": "^1.0.11",
    "@types/passport-jwt": "^3.0.7",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/xss-filters": "^0.0.27",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.12.1",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.1",
    "prisma": "^6.19.3",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.5",
    "swagger-ui-express": "^4.6.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "http-status": "^1.5.3",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pm2": "^5.2.2",
    "winston": "^3.8.2",
    "xss-filters": "^1.2.7"
  },
  "resolutions": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3"
  }
}
